{
  "manifest_version": 2,
  "name": "Claude Browser Bridge",
  "version": "0.1.0",
  "description": "Lets your local Claude Code sessions drive Firefox through a loopback-only MCP bridge. No remote servers, no auto-update URL.",
  "permissions": ["tabs", "scripting", "storage", "<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Claude Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-browser-bridge@jhueby",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
